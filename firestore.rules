rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lecture pour tout utilisateur connecté (recherche de colocs + abonnements) ;
    // écriture réservée au propriétaire du doc.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      function isMember() {
        return request.auth != null && (
          (resource.data.member_ids != null && request.auth.uid in resource.data.member_ids) ||
          resource.data.user1_id == request.auth.uid ||
          resource.data.user2_id == request.auth.uid
        );
      }
      // Any authenticated user can read a group (needed for invite-code lookup) and create one.
      allow read, create: if request.auth != null;
      // Existing members can update; a new coloc may join by adding only themselves.
      allow update: if isMember()
        || (request.auth != null
            && request.resource.data.member_ids != null
            && request.auth.uid in request.resource.data.member_ids);
      // Only members can delete the group.
      allow delete: if isMember();
    }

    match /follows/{followId} {
      // Anyone authenticated can read (to list following / followers).
      allow read: if request.auth != null;
      // A user can only create/delete their own follow edges.
      allow create: if request.auth != null
        && request.resource.data.follower_id == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.follower_id == request.auth.uid;
    }

    match /group_invitations/{invitationId} {
      // Inviter and invitee can read; the invitee-scoped query relies on this.
      allow read: if request.auth != null && (
        resource.data.invitee_id == request.auth.uid ||
        resource.data.inviter_id == request.auth.uid
      );
      // The inviter creates the invitation for someone else.
      allow create: if request.auth != null
        && request.resource.data.inviter_id == request.auth.uid;
      // Inviter or invitee can update (accept / reject).
      allow update: if request.auth != null && (
        resource.data.invitee_id == request.auth.uid ||
        resource.data.inviter_id == request.auth.uid
      );
    }

    // Authenticated users can read/write listings (cached by clients)
    match /listings/{listingId} {
      allow read, write: if request.auth != null;
    }

    // Users can read and write their own swipes; all authenticated users can read
    match /swipes/{swipeId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Authenticated users can read/write matches
    match /matches/{matchId} {
      allow read, write: if request.auth != null;
    }

    // Chat messages for a matched listing — members of the couple only
    match /matches/{matchId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.user_id == request.auth.uid;
    }

    // Crash reports written by the client error reporter (errorReporting.ts).
    match /crash_reports/{id} {
      allow write: if true;
    }
  }
}